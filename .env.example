# Shared bearer token for MCP (/mcp) and REST (/v0/*). /health stays open.
CALL_BRIDGE_TOKEN=replace-me-with-a-long-random-string

# Caller identity: token hashes bound to systems (see README「発信者の本人確認」).
# With it set, CALL_BRIDGE_TOKEN stays as the unrestricted legacy token during migration.
# CALL_BRIDGE_TOKENS_FILE=/run/call-bridge/tokens.json

# Optional overrides
# CALL_BRIDGE_HOST=0.0.0.0
# CALL_BRIDGE_PORT=18910
# CALL_BRIDGE_DB=data/calls.db

# DNS-rebinding allowlists (comma-separated). Defaults are localhost-only.
# Example for a public host:
# CALL_BRIDGE_ALLOWED_HOSTS=bridge.example.com,127.0.0.1:*,localhost:*
# CALL_BRIDGE_ALLOWED_ORIGINS=https://bridge.example.com,http://127.0.0.1:*,http://localhost:*

# Phone directory, read on every call_directory. A seat profile edit shows up on
# the next call. No periodic sync, no Marian routine, and no post-edit push.
# 1) Preferred: HTTP GET over an AF_UNIX socket. Prod mounts the socket's
#    parent directory (./dirlive:/run/dirlive) so a recreated socket is visible
#    without recreating the container.
#    Box directory-live listens on 127.0.0.1:18765, SSH -R 127.0.0.1:18765 to
#    main-server, host socat forwards the unix socket to that port.
#    CALL_BRIDGE_DIRECTORY_UNIX=/run/dirlive/dirlive.sock
#    CALL_BRIDGE_DIRECTORY_UNIX_PATH=/v0/directory
# 2) If the socket is unset or the GET fails: HTTP GET this URL.
#    CALL_BRIDGE_DIRECTORY_URL=http://127.0.0.1:18765/v0/directory
# 3) If every configured remote fails: local profile tree, then directory.json.
# AUTH is a raw bearer token, or a full "Bearer …" value, sent on both remote
# GETs. Not a committed secret. TIMEOUT applies to each remote GET.
# CALL_BRIDGE_DIRECTORY_UNIX=
# CALL_BRIDGE_DIRECTORY_UNIX_PATH=/v0/directory
# CALL_BRIDGE_DIRECTORY_URL=
# CALL_BRIDGE_DIRECTORY_URL_AUTH=
# CALL_BRIDGE_DIRECTORY_URL_TIMEOUT=2.5
# BellTeam directory and direct delivery over a mounted UNIX socket.
# CALL_BRIDGE_BELLTEAM_SOCKET_HOST=/home/kite/BellTeam/runtime/data/bots/bot-7b140b27/integrations/grokbot-bridge
# CALL_BRIDGE_BELLTEAM_UNIX=/run/bellteam/bellteam.sock
# Local profile tree when remotes are unset or down (ignored as a second guess
# when set but missing). Unset uses /home/box/agent-data/agents if that directory exists.
# CALL_BRIDGE_AGENTS_ROOT=/home/box/agent-data/agents
# Last-resort snapshot only (not a live profile read):
# CALL_BRIDGE_DIRECTORY=/app/directory.json

# Switchboard webhook (Marian). Same URL and Authorization for every event.
# A local call_send to a GrokBot member stores the text in the bridge and,
# when the member has nothing unread in that session, POSTs grokbot.call.v0
# event session.opened as a ring: session id, member name and agent id,
# local labels, purpose, and the public MCP URL. That event has no message
# body; the member reads the text with call_poll. If the URL is empty, local
# call_send fails and does not store the message. call_open posts nothing.
# The same URL is used when a real request finds the directory unix socket
# down: one POST per 60 seconds,
# {"event":"bridge.link_down","link":"directory","detail":"..."}.
# There is no background health check. Do not put secrets in that detail.
# A failed ring does not send bridge.link_down.
# AUTH is the Authorization header value only (for example "Bearer crsr_…"),
# not the "Authorization:" key name. Do not commit real secrets. The payload
# never includes this value.
# CALL_BRIDGE_WAKE_WEBHOOK_URL=
# CALL_BRIDGE_WAKE_WEBHOOK_AUTH=
# Aliases (same meaning, used when the primary var is unset):
# CALL_BRIDGE_SWITCHBOARD_WEBHOOK_URL=
# CALL_BRIDGE_SWITCHBOARD_WEBHOOK_AUTH=
# Ring again when the oldest unread message is at least this old (seconds):
# CALL_BRIDGE_RERING_SECONDS=600
# MCP URL included in the ring:
# CALL_BRIDGE_PUBLIC_MCP_URL=https://call.kitepon.dev/mcp
